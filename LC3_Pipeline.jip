      "0f3d6af0-7222-4451-95b5-fb3cb4a9223b/jipipe:data-batch-generation/skip-incomplete" : {
        "pinned" : true,
        "name" : "Skip incomplete data sets",
        "description" : "If enabled, incomplete data sets are silently skipped. Otherwise an error is displayed if such a configuration is detected."
      },
      "c879205d-4ab0-454b-acca-64dec6d600a9/jipipe:parameter-slot-algorithm/parameter-annotations-use-internal-names" : {
