      "e85c996a-b4db-4f45-b684-15907c47225d/jipipe:algorithm:runtime-partition" : {
        "pinned" : true,
        "name" : "Partition",
        "description" : "Allows to move the node into a different runtime partition, which determine how the workload is executed."
      },
      "e6b33a57-3b09-48c6-891d-a2dac521a654/code" : {
        "name" : "Script",
        "description" : "The Python script to be executed. The script comes with various API functions and variables that allow to communicate with JIPipe: <ul><li><code>jipipe_inputs</code> is a dict of input slots.</li><li><code>jipipe_outputs</code> is a dict of output slots.</li><li><code>jipipe_annotations</code> is a dict of annotation variables of the current iteration step.</li><li><code>jipipe_variables</code> is a dict of variables passed from the script parameters.</li></ul>The script is designed to be used with the JIPipe Python API (supplied automatically by default). You can find the full API documentation here: https://jipipe.hki-jena.de/apidocs/python-current/index.html"
      },
      "0f313ea3-85ca-4bbf-bc94-7cffde6521d1/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
        "description" : "If enabled, lock the location and size of this node. Does not affect automated alignment operations. Will lock the size if the node supports a resize handle. Will prevent deletion of the node by the user. Slots can still be edited/connected and parameters can still be changed."
      },
      "b969e227-e86e-4143-a8f7-b8a91a4944d2/jipipe:adaptive-parameters/parameter-annotations-use-internal-names" : {
        "name" : "Parameter annotations use internal names",
        "description" : "Generated parameter annotations use their internal unique names."
      },
      "6e704087-3d32-4614-ab5e-3e65f563117d/annotation-name-filter" : {
        "name" : "Annotation name filter",
        "description" : "Filters the name of the added annotations. \n\nThis parameter is an expression that has two modes: (1) Selecting an existing string, and (2) Matching an existing strings by boolean operators<br/><ol><li>Type in the string in double quotes. Example: <pre>\"hello world\"</pre></li><li>The function iterates through all strings. It should return TRUE for one of them. You will have a variable 'value' available within the expression. Example: <pre>value CONTAINS \"hello\"</pre></li></ol>"
      },
      "89bb4bb9-d8d2-409b-a278-4cb4dcfff69f/t-annotation" : {
        "name" : "Annotate with T locations",
        "description" : "Adds the ROI T locations as annotation. The first index is 1. A value of 0 indicates that the ROI is located on all planes."
      },
      "c879205d-4ab0-454b-acca-64dec6d600a9/jipipe:algorithm:pass-through" : {
        "pinned" : true,
        "name" : "Pass through",
        "description" : "If enabled, the algorithm will pass the input data directly to the output data without any processing. This is different from enabling/disabling the algorithm as this will not disable dependent algorithms.\nPlease note that setting this parameter via adaptive parameters (if available) does not always yield the expected result. The reason behind this is that pass-through is not trivial for certain nodes. We recommend to use a split node if node execution should be made adaptive."
      },
      "56560446-eea5-4d59-9380-bb1058d01463/jipipe:data-batch-generation/custom-matched-columns-expression" : {
        "pinned" : true,
        "name" : "Custom grouping columns",
        "description" : "Only used if 'Grouping method' is set to 'Custom'. Determines which annotation columns are referred to group data sets. \n\nThis parameter is an expression that has two modes: (1) Selecting an existing string, and (2) Matching an existing strings by boolean operators<br/><ol><li>Type in the string in double quotes. Example: <pre>\"hello world\"</pre></li><li>The function iterates through all strings. It should return TRUE for one of them. You will have a variable 'value' available within the expression. Example: <pre>value CONTAINS \"hello\"</pre></li></ol>"
      },
      "0f313ea3-85ca-4bbf-bc94-7cffde6521d1/jipipe:data-batch-generation/skip-incomplete" : {
        "pinned" : true,
        "name" : "Skip incomplete data sets",
        "description" : "If enabled, incomplete data sets are silently skipped. Otherwise an error is displayed if such a configuration is detected."
      },
      "b9d3d1fb-d888-4b08-8f12-d11dceb9a57f/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
