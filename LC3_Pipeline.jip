      "c905c3cc-501d-4f24-8978-b2bd46449f32/functions" : {
        "name" : "Functions",
        "description" : "The functions that allow you to extract and replace annotation values. To extract values, you can split the incoming string into multiple components and then select the n-th component or select the one that matches RegEx. Alternatively you can define a RegEx string that contains a matching group (brackets). This matching group will then be picked."
      },
      "354a8799-090f-401d-8e5a-ec6b658fc4b3/jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations" : {
