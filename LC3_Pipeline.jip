      "94dc90ab-d1c5-4129-bb82-63db3dcfd3f1" : {
        "jipipe:graph-compartment" : "12675e4f-74fc-4924-847f-370a2bc08e26",
        "jipipe:alias-id" : "normilize-per-monocyte-1",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Output 1" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output 1",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/12675e4f-74fc-4924-847f-370a2bc08e26/x" : 1,
          "location/12675e4f-74fc-4924-847f-370a2bc08e26/y" : 95,
          "location/_/y" : 88,
          "location/_/x" : 10
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport numpy as np\nimport pandas as pd\nfrom skimage.measure import label\n\n# -----------------------------\n# Load single compact input\n# Expected logical dimensions:\n# W x H x C x Z x T\n#\n# For each channel:\n# Z0 = green mask\n# Z1 = phagocyte mask\n# Z2 = red image\n# -----------------------------\nds = jipipe_inputs[\"Input\"]\nimg = load_image_file(data_slot=ds, row=0)\n\nimg = np.asarray(img)\nimg = np.squeeze(img)\n\n# -----------------------------\n# Convert image to C, Z, Y, X\n# C may vary, Z must be 3\n# -----------------------------\nif img.ndim == 4:\n\n    # C, Z, Y, X\n    if img.shape[1] == 3:\n        img_czyx = img\n\n    # Z, C, Y, X\n    elif img.shape[0] == 3:\n        img_czyx = np.moveaxis(img, 0, 1)\n\n    # Y, X, C, Z\n    elif img.shape[3] == 3:\n        img_czyx = np.moveaxis(img, [2, 3], [0, 1])\n\n    # Y, X, Z, C\n    elif img.shape[2] == 3:\n        img_czyx = np.moveaxis(img, [3, 2], [0, 1])\n\n    else:\n        raise ValueError(f\"Could not find Z=3 axis in image shape: {img.shape}\")\n\nelif img.ndim == 5:\n\n    # Remove singleton T axis\n    if 1 in img.shape:\n        img = np.squeeze(img)\n\n        if img.ndim != 4:\n            raise ValueError(\n                f\"After removing singleton axis, expected 4D image, got: {img.shape}\"\n            )\n\n        # C, Z, Y, X\n        if img.shape[1] == 3:\n            img_czyx = img\n\n        # Z, C, Y, X\n        elif img.shape[0] == 3:\n            img_czyx = np.moveaxis(img, 0, 1)\n\n        # Y, X, C, Z\n        elif img.shape[3] == 3:\n            img_czyx = np.moveaxis(img, [2, 3], [0, 1])\n\n        # Y, X, Z, C\n        elif img.shape[2] == 3:\n            img_czyx = np.moveaxis(img, [3, 2], [0, 1])\n\n        else:\n            raise ValueError(f\"Could not find Z=3 axis after squeeze: {img.shape}\")\n\n    else:\n        raise ValueError(f\"Expected one singleton T axis, got shape: {img.shape}\")\n\nelse:\n    raise ValueError(f\"Expected 4D or 5D image, got shape: {img.shape}\")\n\n# -----------------------------\n# Final interpreted shape\n# -----------------------------\nn_channels = img_czyx.shape[0]\nn_z = img_czyx.shape[1]\nheight = img_czyx.shape[2]\nwidth = img_czyx.shape[3]\n\nif n_z != 3:\n    raise ValueError(f\"Expected exactly 3 Z slices, got {n_z}\")\n\nresults = []\nrestricted_stack = np.zeros((n_channels, height, width), dtype=np.uint8)\n\n# -----------------------------\n# Analyze each channel separately\n# -----------------------------\nfor c in range(n_channels):\n\n    green_mask = img_czyx[c, 0, :, :]\n    phagocyte_mask = img_czyx[c, 1, :, :]\n    red_image = img_czyx[c, 2, :, :]\n\n    # Ensure phagocyte mask is labeled\n    if len(np.unique(phagocyte_mask[phagocyte_mask > 0])) <= 1:\n        phagocyte_mask = label(phagocyte_mask > 0)\n\n    green_binary = green_mask > 0\n    overlap_mask = green_binary & (phagocyte_mask > 0)\n\n    if np.any(overlap_mask):\n\n        overlapping_phago_labels = phagocyte_mask[overlap_mask]\n        phago_ids, counts = np.unique(\n            overlapping_phago_labels,\n            return_counts=True\n        )\n\n        best_phago = phago_ids[np.argmax(counts)]\n\n        final_ring_pixels = green_binary & (phagocyte_mask == best_phago)\n\n        ring_mean_red = red_image[final_ring_pixels].mean()\n\n        phago_pixels = phagocyte_mask == best_phago\n        phago_mean_red = red_image[phago_pixels].mean()\n\n        ratio = ring_mean_red / phago_mean_red if phago_mean_red != 0 else np.nan\n\n        restricted_stack[c] = 255 * final_ring_pixels.astype(np.uint8)\n\n        results.append([\n            c + 1,\n            ring_mean_red,\n            best_phago,\n            phago_mean_red,\n            ratio\n        ])\n\n    else:\n        results.append([\n            c + 1,\n            np.nan,\n            np.nan,\n            np.nan,\n            np.nan\n        ])\n\n# -----------------------------\n# Output table\n# -----------------------------\ndf = pd.DataFrame(results, columns=[\n    \"channel_id\",\n    \"ring_mean_red\",\n    \"monocyte_id\",\n    \"monocyte_mean_red\",\n    \"ratio\"\n])\n\ndso = jipipe_outputs[\"Output\"]\nadd_table(df, dso)\n\n# -----------------------------\n# Output restricted green mask stack\n# Shape: C, Y, X\n# One restricted mask per channel\n# -----------------------------\n#dso = jipipe_outputs[\"Output 1\"]\n#add_image(restricted_stack, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Normilize per monocyte ",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "cleanup-afterwards" : true,
        "jipipe:local-parallelization-num-threads" : {
          "content" : 1,
          "enabled" : false
        },
        "jipipe:algorithm:custom-expression-variables" : {
          "parameters" : { }
        },
        "jipipe:environment-overrides" : {
          "parameters" : {
            "jipipe-python-adapter-library" : {
