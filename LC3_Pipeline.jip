      "89bb4bb9-d8d2-409b-a278-4cb4dcfff69f/count-annotation" : {
        "name" : "Annotate with list size",
        "description" : "Adds the size of the ROI list as annotation"
      },
      "0f3d6af0-7222-4451-95b5-fb3cb4a9223b/jipipe:parameter-slot-algorithm/parameter-annotations-use-internal-names" : {
        "name" : "Parameter annotations use internal names",
