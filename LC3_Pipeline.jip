        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import ttest_ind\n\n# ----------------------------\n# User-defined column names\n# ----------------------------\ntreatment_column = \"treatement\"\nratio_column = \"ratio\"\ndonor_column = \"donor\"\n\n# ----------------------------\n# User-defined groups\n# ----------------------------\ngroup1_label = \"MoC+Af\"\ngroup2_label = \"MoC+GSK+Af\"\n\n# ----------------------------\n# Load input table\n# ----------------------------\nds = jipipe_inputs[\"Input\"]\ndf = load_table_file(data_slot=ds, row=0)\n\n# ----------------------------\n# Clean treatment names\n# ----------------------------\ndf[treatment_column] = df[treatment_column].replace({\n    \"MoC+A.f\": \"MoC+Af\",\n    \"MoC+GSK+A.f\": \"MoC+GSK+Af\"\n})\ndonor_column = \"donor\"\n\n# Find smallest group size across all donor/treatment combinations\nmin_n = df.groupby([donor_column, treatment_column]).size().min()\n\n# Randomly sample the same number of rows from each combination\ndf = (\n    df.groupby([donor_column, treatment_column], group_keys=False)\n      .sample(n=min_n, random_state=42)\n      .reset_index(drop=True)\n)\n# ----------------------------\n# Global figure style\n# ----------------------------\nplt.rcParams.update({\n    \"font.size\": 11,\n    \"axes.linewidth\": 1.2,\n    \"xtick.major.width\": 1.2,\n    \"ytick.major.width\": 1.2,\n    \"xtick.direction\": \"out\",\n    \"ytick.direction\": \"out\",\n    \"pdf.fonttype\": 42,\n    \"ps.fonttype\": 42\n})\n\ndef significance_text(p):\n    if p < 0.001:\n        return \"***\"\n    elif p < 0.01:\n        return \"**\"\n    elif p < 0.05:\n        return \"*\"\n    else:\n        return \"n.s.\"\n\ndef cohens_d(x, y):\n    x = np.asarray(x)\n    y = np.asarray(y)\n\n    nx = len(x)\n    ny = len(y)\n\n    if nx < 2 or ny < 2:\n        return np.nan\n\n    sx = np.std(x, ddof=1)\n    sy = np.std(y, ddof=1)\n\n    pooled_sd = np.sqrt(((nx - 1) * sx**2 + (ny - 1) * sy**2) / (nx + ny - 2))\n    if pooled_sd == 0:\n        return np.nan\n\n    return (np.mean(y) - np.mean(x)) / pooled_sd\n\n# ----------------------------\n# Precompute global y-limits\n# ----------------------------\nplot_df = df[df[donor_column].isin([\"D4\", \"D5\", \"D6\"])].copy()\n\nglobal_y_min = plot_df[ratio_column].min()\nglobal_y_max = plot_df[ratio_column].max()\nglobal_y_range = global_y_max - global_y_min if global_y_max > global_y_min else 1.0\n\ny_lower = global_y_min - 0.05 * global_y_range\ny_upper = global_y_max + 0.18 * global_y_range\n\n# Common annotation positions\nline_y = global_y_max + 0.07 * global_y_range\nline_h = 0.03 * global_y_range\ntext_y = line_y + 0.015 * global_y_range\n\ndef plot_group(ax, donors, title, show_ylabel=False):\n    sub = df[df[donor_column].isin(donors)]\n\n    g1 = sub.loc[sub[treatment_column] == group1_label, ratio_column].dropna().to_numpy()\n    g2 = sub.loc[sub[treatment_column] == group2_label, ratio_column].dropna().to_numpy()\n\n    # Stats\n    tstat, pval = ttest_ind(g1, g2, equal_var=False)\n    d = cohens_d(g1, g2)\n\n    # Boxplot\n    ax.boxplot(\n        [g1, g2],\n        positions=[1, 2],\n        widths=0.5,\n        patch_artist=True,\n        showfliers=True,\n        medianprops=dict(color=\"black\", linewidth=1.2),\n        boxprops=dict(facecolor=\"white\", edgecolor=\"black\", linewidth=1.2),\n        whiskerprops=dict(color=\"black\", linewidth=1.2),\n        capprops=dict(color=\"black\", linewidth=1.2)\n    )\n\n    # Mean\n    ax.scatter(\n        [1, 2],\n        [np.mean(g1), np.mean(g2)],\n        s=70,\n        facecolors=\"white\",\n        edgecolors=\"black\",\n        linewidths=1.5,\n        zorder=4\n    )\n\n    # Significance\n    ax.plot(\n        [1, 1, 2, 2],\n        [line_y, line_y + line_h, line_y + line_h, line_y],\n        color=\"black\",\n        linewidth=1.2,\n        clip_on=False\n    )\n    ax.text(1.5, text_y, significance_text(pval), ha=\"center\", va=\"bottom\", fontsize=11)\n\n    # Labels\n    ax.set_title(title)\n    ax.set_xticks([1, 2])\n    ax.set_xticklabels([group1_label, group2_label])\n\n    if show_ylabel:\n        ax.set_ylabel(\" Ring by Monocytes Intensity Ratio\")\n\n\n    ax.set_ylim(y_lower, y_upper)\n\n    # Clean axes\n    ax.spines[\"top\"].set_visible(False)\n    ax.spines[\"right\"].set_visible(False)\n    ax.set_xlim(0.5, 2.5)\n\n    # Stats text\n    ax.text(\n        0.03, 0.97,\n        f\"p = {pval:.2e}\\nd = {d:.2f}\\nn = {len(g1)}, {len(g2)}\",\n        transform=ax.transAxes,\n        ha=\"left\",\n        va=\"top\",\n        fontsize=9\n    )\n\n    return pval\n\n# ----------------------------\n# Multi-panel figure\n# ----------------------------\nfig, axes = plt.subplots(1, 3, figsize=(12, 5), sharey=True, constrained_layout=True)\n\nplot_group(axes[0], [\"D4\"], \"D4\", show_ylabel=True)\nplot_group(axes[1], [\"D5\"], \"D5\")\nplot_group(axes[2], [\"D6\"], \"D6\")\n\nfig.supxlabel(\"Treatment\")\nplt.show()\n\n# ----------------------------\n# Output table\n# ----------------------------\ndso = jipipe_outputs[\"Output\"]\nadd_table(df, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Boxplot of Ratio by Treatement by Donor",
