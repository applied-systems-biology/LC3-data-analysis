        "description" : "Text prefixed to generated parameter annotations."
      },
      "2598cf42-cae5-4c76-9f48-00604c1c9f29/renaming-items" : {
        "name" : "Renaming items",
        "description" : "Determines which annotation columns are renamed."
      },
      "9f847c51-bd72-4e5c-abce-40f44bd29043/roi1/consume-overlap" : {
        "name" : "Consume on overlap",
        "description" : "If enabled, ROI are consumed if an overlap is detected, meaning that no other tested ROI can overlap with it. This is useful if you want to prevent duplicate overlaps (e.g., if you compare automated vs manually segmented blobs)."
      },
      "3850fea3-b290-47ee-a87c-cbd3a2a1aca9/jipipe:node:name" : {
