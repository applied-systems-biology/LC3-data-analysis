      "c879205d-4ab0-454b-acca-64dec6d600a9/roi1/enforce-overlap" : {
        "name" : "Overlap filter: enforce overlap",
        "description" : "If enabled, a pair of ROI is not considered for custom filtering if it does not overlap. Disable this setting if you want to implement special behavior."
