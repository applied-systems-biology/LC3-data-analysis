      },
      "38b662d0-f92a-4b1d-bbf9-a601a7ea764e/filter" : {
        "name" : "Only keep data if",
        "description" : "The filter is an expression that should return a boolean value that indicates whether a data item should be put into the corresponding output.Annotation values are available as variables. If an annotation has spaces special characters, use $ to access its value. Examples: <pre>#Dataset CONTAINS \"Raw\" AND condition EQUALS \"mock\"</pre><pre>TO_NUMBER($\"my column\") < 10</pre>\n\nThe expression result will be converted to a string. All existing annotations are available as variables that can be accessed directly, or if they contain special characters or spaces via the $ operator."
      },
      "7ffc3a8d-a6d9-4603-bbf4-0eb7ea2ffb86/jipipe:node:bookmarked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Bookmark this node",
        "description" : "If enabled, the node is highlighted in the graph editor UI and added into the bookmark list."
      },
      "371d22f5-8186-402e-be97-8ebf60dd433b/jipipe:adaptive-parameters/overridden-parameters" : {
        "important" : true,
        "name" : "Overridden parameters",
        "description" : "Here you can override the value of parameters based on annotations. The 'Value' settings should return a value for the parameter type or a JSON string that can be converted into a valid parameter value. The 'Parameter key' setting determines to which parameter this value is written to."
      },
      "08a2e0a1-9299-4a28-b30c-81088bd96237/jipipe:adaptive-parameters/overridden-parameters" : {
