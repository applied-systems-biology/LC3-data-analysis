      "e6b33a57-3b09-48c6-891d-a2dac521a654" : {
        "jipipe:graph-compartment" : "12675e4f-74fc-4924-847f-370a2bc08e26",
        "jipipe:alias-id" : "normilize-per-monocyte-2",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : true,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Input 1" : {
              "slot-data-type" : "imagej-imgplus-greyscale-32f",
              "slot-type" : "Input",
              "name" : "Input 1",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Input 2" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Input 2",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Output 1" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Output",
              "name" : "Output 1",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:metadata-v1" : {
          "location/12675e4f-74fc-4924-847f-370a2bc08e26/x" : 13,
          "location/12675e4f-74fc-4924-847f-370a2bc08e26/y" : 81,
          "location/_/y" : 49,
          "location/_/x" : 31
        },
        "jipipe:node-info-id" : "cpython-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from jipipe.imagej import *\nfrom skimage.filters import gaussian\nimport numpy as np\nimport pandas as pd\nfrom skimage.measure import label\n\n# -----------------------------\n# Load inputs\n# -----------------------------\nds = jipipe_inputs[\"Input\"]\ngreen_mask = load_image_file(data_slot=ds, row=0)\n\nds = jipipe_inputs[\"Input 1\"]\nphagocyte_mask = load_image_file(data_slot=ds, row=0)\n\nds = jipipe_inputs[\"Input 2\"]\nred_image = load_image_file(data_slot=ds, row=0)\n\n# Ensure phagocyte mask is labeled\nif len(np.unique(phagocyte_mask[phagocyte_mask > 0])) <= 1:\n    phagocyte_mask = label(phagocyte_mask > 0)\n\n# Treat green mask as ONE ring/object\ngreen_binary = green_mask > 0\n\n# Keep only green pixels that overlap phagocytes\noverlap_mask = green_binary & (phagocyte_mask > 0)\n\n# New green mask output: one single ring label\nrestricted_green_mask = overlap_mask.astype(np.uint16)\n\nresults = []\n\nif np.any(overlap_mask):\n\n    # Find monocyte/phagocyte with largest overlap with the ring\n    overlapping_phago_labels = phagocyte_mask[overlap_mask]\n    phago_ids, counts = np.unique(overlapping_phago_labels, return_counts=True)\n\n    best_phago = phago_ids[np.argmax(counts)]\n\n    # Analyze ring only where it overlaps the best monocyte\n    final_ring_pixels = green_binary & (phagocyte_mask == best_phago)\n\n    conidium_mean = red_image[final_ring_pixels].mean()\n\n    phago_pixels = phagocyte_mask == best_phago\n    phago_mean = red_image[phago_pixels].mean()\n\n    ratio = conidium_mean / phago_mean if phago_mean != 0 else np.nan\n\n    results.append([\n        1,\n        conidium_mean,\n        best_phago,\n        phago_mean,\n        ratio\n    ])\n\n    # Output mask: only ring pixels overlapping the selected monocyte\n    restricted_green_mask = final_ring_pixels.astype(np.uint16)\n\nelse:\n    results.append([1, np.nan, np.nan, np.nan, np.nan])\n\ndf = pd.DataFrame(results, columns=[\n    \"ring_id\",\n    \"ring_mean_red\",\n    \"monocyte_id\",\n    \"monocyte_mean_red\",\n    \"ratio\"\n])\n\n\n# -----------------------------\n# Output table\n# -----------------------------\ndso = jipipe_outputs[\"Output\"]\nadd_table(df, dso)\n\n# -----------------------------\n# Output restricted green mask\n# -----------------------------\nrestricted_green_mask = 255*restricted_green_mask.astype(np.uint8)\ndso = jipipe_outputs[\"Output 1\"]\nadd_image(restricted_green_mask, dso)",
          "collapsed" : false
        },
        "suppress-logs" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Normilize per monocyte",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "external-code" : false,
        "cleanup-afterwards" : true,
        "jipipe:local-parallelization-num-threads" : {
          "content" : 1,
          "enabled" : false
        },
        "jipipe:algorithm:custom-expression-variables" : {
          "parameters" : { }
        },
        "jipipe:environment-overrides" : {
          "parameters" : {
            "jipipe-python-adapter-library" : {
